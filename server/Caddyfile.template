# managed-by: hasan-bridge docker compose — ne pas éditer à la main,
# relancer server/install-bridge.sh à la place (idempotent).
#
# tls internal : CA locale auto-signée Caddy, cohérente avec le TOFU déjà
# utilisé côté app Android (CertPinStore.kt) — pas de domaine pour ACME sur
# une IP littérale de toute façon.
#
# default_sni obligatoire : OkHttp/Android n'envoie pas de SNI pour une IP
# littérale (RFC 6066) — sans cette directive globale, Caddy ne sait pas
# quel certificat servir et le handshake TLS échoue ("internal error").
{
	default_sni {{PUBLIC_HOST}}
}

https://{{PUBLIC_HOST}} {
	tls internal

	reverse_proxy 127.0.0.1:8787 {
		# /api/chat/stream et consorts sont du SSE long-lived — désactiver
		# le buffering de flush pour un streaming token-par-token réel.
		flush_interval -1
	}
}
